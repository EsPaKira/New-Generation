@box from (0.28125,0,0.28125) to (0.71875,0.25,0.71875) texture "blocks:wood" delete (top) {
    @part tags (south, north, east, west) region-scale (1.125,1)
    @part tags (bottom) region-scale (1.125)
}
@box from (0.25,0.25,0.25) to (0.75,0.5,0.75) texture "blocks:wood" delete (top)
@box from (0.375,0.5,0.375) to (0.6275,0.125,0.6275) texture "blocks:planks" delete (bottom)
@rect from (0.25,0.5,0.25) right (0.5,0,0) up (0,0,0.125) texture "blocks:wood_top"
@rect from (0.25,0.5,0.625) right (0.5,0,0) up (0,0,0.125) texture "blocks:wood_top"
@rect from (0.625,0.5,0.625) right (0,0,-0.25) up (0.125,0,0) texture "blocks:wood_top"
@rect from (0.25,0.5,0.625) right (0,0,-0.25) up (0.125,0,0) texture "blocks:wood_top"