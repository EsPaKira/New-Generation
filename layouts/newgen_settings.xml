<container size-func="unpack(gui.get_viewport())">
    <image id="background" size-func="unpack(gui.get_viewport())" />
    <button size="75,40" hover-color="050" color="100" gravity="top-right" onclick="go_back()">@Back</button>
    <container size="600,40" position-func="gui.get_viewport()[1]/2-300, 0" color="#00000050">
        <label gravity="center-center">@New Generation settings</label>
    </container>

    <container position-func="gui.get_viewport()[1]/2-300, 50" size="600,2" color="#b7fcfc"></container>

    <container id="gamemodes" size="400,60" color="#00000050" position-func="gui.get_viewport()[1]/2 - 200, 150">
        <container size="300,40" pos="25,10"><label id="current_gamemode" gravity="center-left"></label></container>
    </container>

    <container id="select_bg" size="400,60" color="#00000050" position-func="gui.get_viewport()[1]/2 - 200, 250">
        <container size="160,40" pos="15,10"><label gravity="center-center">@Select background</label></container>
        <select id="bg_select" size="180,40" onselect="function(opt) select_bg(opt) end" pos="205,10" onclick="play_sound()">
            <!-- content is generated in script -->
        </select>
    </container>
</container>
